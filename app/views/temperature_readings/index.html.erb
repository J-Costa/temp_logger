<main class="bg-linear-to-b from-emerald-50 via-white to-cyan-50 min-h-screen">
  <div class="mx-auto w-full max-w-384 px-2 py-4 sm:px-4 sm:py-6 lg:px-6 lg:py-8 space-y-6">
    <section class="mb-8 rounded-3xl border border-emerald-100 bg-white/90 p-6 shadow-sm backdrop-blur sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-emerald-700">Temp Logger</p>
          <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-4xl">Últimas leituras de temperatura</h1>
          <p class="mt-2 text-sm text-slate-600 sm:text-base">Monitoramento em tempo real com <%= pluralize(@temperature_readings.size, "leitura") %>.</p>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:min-w-fit">
          <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-3 sm:p-4">
            <p class="text-xs font-medium uppercase tracking-wide text-emerald-700">Total exibido</p>
            <p class="mt-1 text-2xl font-bold text-emerald-900"><%= @temperature_readings.size %></p>
          </div>

          <div class="rounded-2xl border border-cyan-200 bg-cyan-50 p-3 sm:p-4">
            <p class="text-xs font-medium uppercase tracking-wide text-cyan-700">Média filtrada</p>
            <p class="mt-1 text-2xl font-bold text-cyan-900"><%= format("%.2f", @average_temperature_filtered) %> <span class="text-base">°C</span></p>
          </div>

          <div class="rounded-2xl border border-violet-200 bg-violet-50 p-3 sm:p-4">
            <p class="text-xs font-medium uppercase tracking-wide text-violet-700">Média 24h</p>
            <p class="mt-1 text-2xl font-bold text-violet-900"><%= format("%.2f", @average_temperature) %> <span class="text-base">°C</span></p>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 text-lg font-semibold text-slate-900">Filtros</h2>
      <%= render "temperature_filter", time_range: @time_range, temp_range: @temp_range %>
    </section>

    <%= render "temperature_chart", chart_series: @chart_series %>

    <section id="temperature-readings-list">
      <%= render "temperature_readings_list", temperature_readings: @temperature_readings %>
    </section>
  </div>
</main>
